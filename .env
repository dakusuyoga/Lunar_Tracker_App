# Supabase connection — COMMITTED ON PURPOSE.
#
# Vite substitutes these at BUILD time, so they are baked into the JavaScript
# bundle and downloadable by anyone who opens the site. Keeping them out of
# the repo would protect nothing and would leave the GitHub Actions build with
# no credentials at all (it never sees .env.local), producing a deployed app
# that fails silently.
#
# The anon key is designed to be public. Row-Level Security is what actually
# guards the data — see the Supabase runbook, "The one thing that governs
# everything". The service_role key must NEVER appear here or anywhere in the
# frontend: it bypasses RLS entirely.

VITE_SUPABASE_URL=https://elclpiwwdznyyjhafruk.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVsY2xwaXd3ZHpueXlqaGFmcnVrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU0NjQyMDEsImV4cCI6MjEwMTA0MDIwMX0.zy3p1IjsOnsprBrOwRUxvg4xrAOg8KR2HkoS61BmGVU
